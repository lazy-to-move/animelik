# Backend
APP_ID=                   # Application ID
APP_SECRET=               # Application secret used for JWT signing (32+ characters recommended). Share this with apps/public-web for direct Next auth/watchlist mode.

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/synx
SITE_URL=https://your-domain.example
PUBLIC_WEB_URL=           # Optional split-host public frontend origin. When set, the legacy web service 307-redirects consumer HTML routes to the Next public-web app.

# Frontend (exposed to browser via Vite)
VITE_GOOGLE_CLIENT_ID=    # Google web client ID

# Backend auth
GOOGLE_CLIENT_ID=         # Google web client ID

# Ownership / bootstrap
OWNER_UNION_ID=           # First owner unionId to promote as admin if needed

# Runtime
PORT=3000
PUPPETEER_EXECUTABLE_PATH= # Optional custom Chrome/Chromium binary path
IMPORTED_MEDIA_DIR=        # Optional writable directory for runtime-downloaded covers
MEDIA_STORAGE_MODE=local   # local or s3; defaults to s3 when S3_MEDIA_BUCKET is set
MEDIA_PUBLIC_BASE_URL=     # Required for s3 mode, e.g. https://cdn.example.com
S3_MEDIA_BUCKET=           # Optional object storage bucket for covers/posters
S3_MEDIA_REGION=auto       # Region for S3/R2-compatible storage
S3_MEDIA_ENDPOINT=         # Optional custom endpoint, e.g. https://<account>.r2.cloudflarestorage.com
S3_MEDIA_ACCESS_KEY_ID=
S3_MEDIA_SECRET_ACCESS_KEY=
S3_MEDIA_FORCE_PATH_STYLE=false
SCRAPER_EXECUTION_MODE=inline # inline for local/dev, queue for a paid web+worker setup
SCRAPER_QUEUE_BACKEND=db     # db or bullmq; defaults to bullmq when REDIS_URL is set
REDIS_URL=                   # Required when SCRAPER_QUEUE_BACKEND=bullmq
SCRAPER_QUEUE_NAME=synx-scrape-jobs
SCRAPER_WORKER_POLL_MS=5000   # Worker polling interval when queue mode is enabled
MEDIA_BACKFILL_DRY_RUN=false  # Optional safety flag for db:backfill:media
MEDIA_BACKFILL_LIMIT=         # Optional row limit for db:backfill:media
LEGACY_API_INTERNAL_ORIGIN=   # Optional split-host Next frontend server-side origin, e.g. http://127.0.0.1:3000
LEGACY_API_INTERNAL_HOSTPORT= # Optional Render private-network hostport, e.g. synx-app:10000
NEXT_PUBLIC_LEGACY_API_BASE_URL= # Optional public backend origin for Next media/proxy URLs
NEXT_PUBLIC_SITE_URL=         # Optional public Next frontend origin
