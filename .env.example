# Backend
APP_ID=                   # Application ID
APP_SECRET=               # Application secret used for JWT signing

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/synx
SITE_URL=https://your-domain.example

# Frontend (exposed to browser via Vite)
VITE_GOOGLE_CLIENT_ID=    # Google web client ID

# Backend auth
GOOGLE_CLIENT_ID=         # Google web client ID

# Ownership / bootstrap
OWNER_UNION_ID=           # First owner unionId to promote as admin if needed

# Runtime
PORT=3000
PUPPETEER_EXECUTABLE_PATH= # Optional custom Chrome/Chromium binary path
IMPORTED_MEDIA_DIR=        # Optional writable directory for runtime-downloaded covers
